Day/Night System
C
// src/clock/daynight.c

enum
{
    TIME_MORNING,
    TIME_DAY,
    TIME_NIGHT,
};

u8 GetCurrentTimeOfDay(void)
{
    RTC_Time time;
    RtcCalcLocalTime();

    if (gLocalTime.hours < 6)
        return TIME_NIGHT;
    else if (gLocalTime.hours < 18)
        return TIME_DAY;

    return TIME_NIGHT;
}
